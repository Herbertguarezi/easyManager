{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.production)",
      "Read(./.env.development)",
      "Read(./.env.test)",
      "Read(./**/application-prod.properties)",
      "Read(./**/application-production.properties)",
      "Read(./**/*secret*)",
      "Read(./**/*credentials*)"
    ],
    "additionalDirectories": ["../docs/"]
  },
  "defaultMode": "acceptEdits"
}